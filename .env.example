# Copy to .env. Never commit your .env or credentials.
AUDIT_MODE=live
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
COOKIE_SECURE=false

# Stable, unique identity for this source. Do not reuse it for another server.
SQL_SOURCE_ID=sql-test-01
# Windows integrated authentication uses the identity running collector.py.
# Use the server DNS name in its TLS certificate; a named instance may need a port.
SQL_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-sql-server,1433;DATABASE=master;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=no;APP=SQLAuditTrailCollector"
# Path is on SQL SERVER, not your laptop. Match only this application's audit.
SQL_AUDIT_FILE_PATTERN='C:\SqlAudit\AppAuditTrail_*.sqlaudit'
COLLECTOR_INTERVAL_SECONDS=10
SQL_QUERY_TIMEOUT=120

# SQL login alternative (server must allow mixed mode):
# SQL_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-sql-server,1433;DATABASE=master;UID=audit_reader;PWD=your-secret;Encrypt=yes;TrustServerCertificate=no;APP=SQLAuditTrailCollector"
